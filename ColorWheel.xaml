<UserControl x:Class="FoxAutoClicker.ColorWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="180" Cursor="Cross" Focusable="False">
    <Grid x:Name="Surface" Background="Transparent"
          MouseLeftButtonDown="Surface_MouseDown" MouseMove="Surface_MouseMove" MouseLeftButtonUp="Surface_MouseUp">
        <Image x:Name="WheelImage" Stretch="Fill" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Canvas IsHitTestVisible="False">
            <!-- işaretçi: dışta koyu, içte açık halka; içi seçili renk -->
            <Ellipse x:Name="ThumbOuter" Width="24" Height="24" Fill="#59000000"/>
            <Ellipse x:Name="Thumb" Width="20" Height="20" Stroke="White" StrokeThickness="3"/>
        </Canvas>
    </Grid>
</UserControl>
