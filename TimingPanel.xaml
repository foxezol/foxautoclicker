<UserControl x:Class="FoxAutoClicker.TimingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FoxAutoClicker">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.7*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Panel}" Margin="0">
            <StackPanel>
                <TextBlock Style="{StaticResource Title}" Text="{local:L interval}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <RadioButton x:Name="PsFast" Style="{StaticResource Segment}" Content="{local:L preset_fast}" Tag="50" Click="Preset_Click"/>
                    <RadioButton x:Name="PsNormal" Style="{StaticResource Segment}" Content="{local:L preset_normal}" Tag="250" Click="Preset_Click"/>
                    <RadioButton x:Name="PsSlow" Style="{StaticResource Segment}" Content="{local:L preset_slow}" Tag="1000" Click="Preset_Click"/>
                    <RadioButton x:Name="PsCustom" Style="{StaticResource Segment}" Content="{local:L preset_custom}" Click="Custom_Click"/>
                </StackPanel>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/>
                        <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBox x:Name="TbH" Text="0" MaxLength="3" PreviewTextInput="Digits" TextChanged="OnChanged" HorizontalContentAlignment="Center"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{local:L u_hours}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBox x:Name="TbM" Text="0" MaxLength="3" PreviewTextInput="Digits" TextChanged="OnChanged" HorizontalContentAlignment="Center"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{local:L u_minutes}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBox x:Name="TbS" Text="0" MaxLength="4" PreviewTextInput="Digits" TextChanged="OnChanged" HorizontalContentAlignment="Center"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{local:L u_seconds}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBox x:Name="TbMs" Text="100" MaxLength="6" PreviewTextInput="Digits" TextChanged="OnChanged" HorizontalContentAlignment="Center"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{local:L u_ms}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{local:L jitter}"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{local:L jitter_note}"/>
                    </StackPanel>
                    <TextBox x:Name="TbJitter" Grid.Column="1" Width="80" Text="0" MaxLength="5" PreviewTextInput="Digits"
                             TextChanged="OnChanged" HorizontalContentAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Panel}" Margin="0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Style="{StaticResource Title}" Text="{local:L repeat}" Margin="0,0,0,12"/>
                <RadioButton x:Name="RbInf" Content="{local:L repeat_inf}" IsChecked="True"/>
                <RadioButton x:Name="RbCount" Content="{local:L repeat_count}" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="28,0,0,0">
                    <TextBox x:Name="TbCount" Width="86" Text="100" MaxLength="9" PreviewTextInput="Digits" TextChanged="OnChanged"/>
                    <TextBlock x:Name="UnitText" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource BodyMuted}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
