<Window x:Class="FoxAutoClicker.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FoxAutoClicker"
        Title="FoxClicker" Width="332" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True"
        UseLayoutRounding="True" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/app.ico"
        Foreground="{DynamicResource Foreground}" FontFamily="{StaticResource UiFont}" FontSize="14">
    <Border Margin="10" CornerRadius="18" Background="{DynamicResource Card}" Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <!-- Başlık satırı: sürükleyerek taşınır -->
            <Grid Background="Transparent" MouseLeftButtonDown="Drag_MouseDown" Cursor="SizeAll">
                <Border x:Name="Chip" CornerRadius="15" Padding="12,5,14,5" HorizontalAlignment="Left"
                        Background="{DynamicResource ButtonSecondary}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource StatusNeutral}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="ChipText" FontWeight="SemiBold" Text="Hazır"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackBtn" Style="{StaticResource SecondaryButton}" Cursor="Hand"
                            MinHeight="32" Padding="12,4" FontSize="13" Click="Back_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource MiniIcon}" Data="M2 2 H12 V12 H2 Z M2 5 H12" Margin="0,0,7,0"/>
                            <TextBlock Text="{local:L mini_back}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MinBtn" Style="{StaticResource SecondaryButton}" Cursor="Hand" Margin="6,0,0,0"
                            MinHeight="32" MinWidth="32" Padding="0" ToolTip="{local:L mini_minimize}"
                            AutomationProperties.Name="Minimize" Click="Min_Click">
                        <Path Style="{StaticResource MiniIcon}" Data="M2 10 H12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Sayaçlar -->
            <UniformGrid Columns="3" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock x:Name="MClicks" Style="{StaticResource Num}" Text="0"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{local:L m_clicks}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="MKeys" Style="{StaticResource Num}" Text="0"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{local:L m_keys}"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="MTime" Style="{StaticResource Num}" Text="0:00:00"/>
                    <TextBlock Style="{StaticResource Caption}" Text="{local:L m_time}"/>
                </StackPanel>
            </UniformGrid>

            <!-- Etkinleştirme -->
            <UniformGrid Columns="2" Margin="0,14,0,0">
                <Border Background="{DynamicResource ButtonSecondary}" CornerRadius="12" Padding="12,8" Margin="0,0,4,0">
                    <Grid>
                        <TextBlock Text="{local:L mini_mouse}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="SwMouse" Style="{StaticResource MiniSwitch}" HorizontalAlignment="Right"
                                      AutomationProperties.Name="Mouse on/off" Checked="SwMouse_Changed" Unchecked="SwMouse_Changed"/>
                    </Grid>
                </Border>
                <Border Background="{DynamicResource ButtonSecondary}" CornerRadius="12" Padding="12,8" Margin="4,0,0,0">
                    <Grid>
                        <TextBlock Text="{local:L mini_key}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="SwKey" Style="{StaticResource MiniSwitch}" HorizontalAlignment="Right"
                                      AutomationProperties.Name="Keyboard on/off" Checked="SwKey_Changed" Unchecked="SwKey_Changed"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <Button x:Name="StartBtn" Style="{StaticResource StartButton}" Margin="0,14,0,0" MinWidth="0" Click="Start_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StartLabel" Text="Başlat"/>
                    <Border CornerRadius="7" Background="#2E000000" Padding="8,1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StartKey" FontFamily="{StaticResource NumFont}" FontSize="12.5" FontWeight="SemiBold" Text="F6"/>
                    </Border>
                </StackPanel>
            </Button>
            <TextBlock x:Name="Hint" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</Window>
